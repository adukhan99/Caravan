(library
 (name CaravanTools)
 (libraries Caravan unix yojson re cohttp-eio eio eio_main uri ssl eio-ssl)
 (modules (:standard \ gen_tools)))

; all_tools.ml is generated by scanning this directory. Contract: a tool
; file <name>.ml is picked up iff it defines `module <Name>` (capitalized
; filename). delegate.ml is excluded — it needs Eio handles at runtime and
; is instantiated explicitly via Delegate.make.
(rule
 (target all_tools.ml)
 (deps (source_tree .))
 (action (run ocaml %{dep:gen_tools.ml})))
